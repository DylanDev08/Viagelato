# Supabase: crear un proyecto nuevo y ejecutar supabase/schema.sql
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sólo en Vercel: origen HTTPS del backend Render, sin ruta final.
API_ORIGIN=https://viagelato-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SECRETA_BACKEND
# Generar valores independientes y aleatorios de al menos 32 bytes. Nunca usar NEXT_PUBLIC_.
CHECKOUT_RATE_LIMIT_SALT=GENERAR_SECRETO_ALEATORIO
CRON_SECRET=GENERAR_OTRO_SECRETO_ALEATORIO
# Activar sólo después de validar productos, pagos, tarifas, zonas, seguridad y políticas.
ENABLE_CHECKOUT=false
# Activar SOLO después de aplicar la migración 20261103202700_catalog_public_invoker.sql
# y verificar sus políticas RLS. No altera el checkout.
PUBLIC_CATALOG_READ_MODEL=false
# Mantener en false hasta el lanzamiento público.
ENABLE_INDEXING=false

# Lanzamiento gradual: mantener desactivado hasta validar login real del admin.
# El login anterior sigue operativo; luego activar con redeploy en Vercel.
NEXT_PUBLIC_ADMIN_SERVER_LOGIN_ENABLED=false

# Cloudflare Turnstile (opcional hasta configurar el widget real).
# La clave pública NO es un secreto; el secreto de Siteverify jamás lleva NEXT_PUBLIC_.
# Configurar AMBAS juntas en Vercel para activar el reto; una sola rompe la validación.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Lista exacta, sin comodines, de dominios habilitados en Cloudflare.
# Para probar la app actual: viagelato.vercel.app
TURNSTILE_ALLOWED_HOSTNAMES=viagelato.vercel.app
